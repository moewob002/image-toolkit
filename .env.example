# Local Image Toolkit Environment Variables
APP_NAME="Local Image Toolkit"
APP_VERSION="1.0.0"
DEBUG=false

# Security & Limits
MAX_UPLOAD_SIZE_MB=50
MAX_IMAGE_PIXELS=100000000
MAX_BATCH_FILES=50
TEMP_FILE_LIFETIME_SECONDS=3600

# Directory Paths
BASE_DIR=/app
UPLOAD_DIR=/app/uploads
OUTPUT_DIR=/app/output
TEMP_DIR=/app/temp
MODEL_DIR=/app/models

# rembg U2Net model storage cache directory
U2NET_HOME=/app/models
